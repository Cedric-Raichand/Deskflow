{
  "name": "deskflow",
  "productName": "DeskFlow",
  "version": "0.1.0",
  "description": "Safe, previewable, reversible file organising for your computer.",
  "author": "Cedric-Raichand",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "deskflow": "src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "cli": "node src/cli.js",
    "renderer:dev": "vite",
    "app:dev": "electron . --dev",
    "start": "vite build && electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "build": {
    "appId": "io.github.cedric-raichand.deskflow",
    "productName": "DeskFlow",
    "files": [
      "electron/**/*",
      "src/**/*",
      "dist-renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}